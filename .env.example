# Copy this file to .env and fill in real values before running in production.
# npm start loads .env automatically via dotenv.

PORT=3000
ADMIN_PASSWORD=pick-a-strong-one

# Set this in production so the admin session cookie gets the `secure` flag
# (requires serving over HTTPS).
NODE_ENV=production

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# The public URL customers reach this site at (used to build Stripe redirect
# URLs). No trailing slash.
PUBLIC_URL=http://localhost:3000

# Comma-separated ISO country codes Stripe Checkout will collect a shipping
# address for.
SHIP_COUNTRIES=US,CA

# Resend (https://resend.com/api-keys). If unset, emails are logged to the
# console instead of sent — handy for local development.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Book Store <onboarding@resend.dev>

# Where order and contact-form alerts go. Leave unset to skip owner alerts
# (they'll be logged to the console instead).
ADMIN_EMAIL=owner@example.com

# Optional: override where the SQLite file and uploaded images live. Useful
# on hosts with a mounted persistent disk (see render.yaml, which sets
# these to a /data disk automatically). Defaults to data/store.db and
# uploads/ inside the project otherwise.
# DB_PATH=/data/store.db
# UPLOAD_DIR=/data/uploads
